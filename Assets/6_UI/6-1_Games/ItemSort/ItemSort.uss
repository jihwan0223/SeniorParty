* {
    -unity-font-definition: url("../../../8_Fonts/Paperlogy-7Bold.ttf");
}

.screen {
    flex-grow: 1;
    background-color: rgb(245, 240, 230);
    align-items: center;
    /* 고정 padding-top 대신 세로 가운데 정렬. 화면 비율이 다른 기기(시뮬레이터)에서도 내용물이
       항상 화면 중앙에 오게 한다. flex-grow 쓰는 자식(격자 등)은 어차피 남는 공간을 다 차지해서
       이 정렬값과 무관하게 기존과 똑같이 동작한다. */
    justify-content: center;
}

.hidden {
    display: none;
}

/* 태블릿 기준 터치 영역 88dp(약 142) 이상, 글자 28pt(약 45) 이상. */
.back-button {
    position: absolute;
    top: 40px;
    left: 40px;
    height: 90px;
    padding: 0 28px;
    font-size: 36px;
    background-color: rgb(255, 255, 255);
    border-width: 6px;
    border-color: rgb(0, 0, 0);
    border-radius: 14px;
    color: rgb(40, 40, 40);
}

.back-button:active {
    background-color: rgb(225, 225, 225);
    color: rgb(20, 20, 20);
}

.remaining-label {
    -unity-text-align: middle-center;
    font-size: 56px;
    color: rgb(70, 70, 70);
    /* 글자가 없는 게임도 같은 높이를 차지해서, 모든 게임의 안내 문구/본문 위치가 같아진다. */
    height: 76px;
    margin-bottom: 8px;
}

.timer-label {
    -unity-text-align: middle-center;
    font-size: 92px;
    color: rgb(200, 40, 40);
    /* 타이머가 없는 게임도 같은 높이를 차지한다(라운드 라벨과 같은 이유). */
    height: 118px;
    margin-bottom: 16px;
}

/* 숫자(timer-label)와 같이 쓰는 보조 막대. 폭은 컨트롤러가 남은 시간 비율로 정한다. */
.timer-bar-track {
    width: 500px;
    max-width: 80%;
    height: 24px;
    margin: 0 auto 110px;
    border-radius: 12px;
    border-width: 4px;
    border-color: rgb(0, 0, 0);
    background-color: rgb(255, 255, 255);
    overflow: hidden;
    align-self: center;
}

/* 숫자(timer-label)와 같은 빨강으로 맞춘다. */
.timer-bar-fill {
    height: 100%;
    width: 100%;
    background-color: rgb(200, 40, 40);
}

.instruction-label {
    -unity-text-align: middle-center;
    font-size: 56px;
    color: rgb(40, 40, 40);
    max-width: 95%;
    margin-bottom: 32px;
    white-space: normal;
}

/* 미리보기/본 물건 칸을 완전히 같은 구성(현재|다음 표시 - 박스 - 모양 이름)으로 맞춰서
   화살표가 자연스럽게 정가운데에 오게 한다. */
.stage-row {
    flex-direction: row;
    align-items: flex-end;
    justify-content: center;
    margin-bottom: 100px;
}

/* 폭/높이를 박스+이름표 있을 때 크기로 고정해둔다 - 애니메이션 중에 박스를 잠깐 빼면(reparent)
   이 칸이 좁아지거나 낮아지면서 글자가 자리를 옮기거나 깜빡이던 문제가 있었다. 위/아래 끝(제목,
   이름표)을 space-between으로 고정해서, 가운데 박스가 없어져도 둘 다 원래 자리 그대로 있다. */
.stage-column {
    width: 320px;
    height: 460px;
    align-items: center;
    justify-content: space-between;
}

.stage-header-label {
    -unity-text-align: middle-center;
    font-size: 48px;
    color: rgb(30, 30, 30);
    margin-bottom: 12px;
}

.preview-box {
    width: 320px;
    height: 320px;
    padding: 48px;
    border-radius: 14px;
    background-color: rgb(230, 225, 210);
    border-width: 6px;
    border-color: rgb(0, 0, 0);
    transition-property: translate;
    transition-duration: 400ms;
    transition-timing-function: ease-out;
}

.preview-icon {
    flex-grow: 1;
    -unity-background-scale-mode: scale-to-fit;
}

.shape-name-label {
    -unity-text-align: middle-center;
    font-size: 48px;
    color: rgb(60, 60, 60);
    margin-top: 16px;
    white-space: nowrap;
}

.stage-arrow {
    font-size: 84px;
    color: rgb(90, 90, 90);
    margin: 0 40px;
    align-self: center;
}

/* 미리보기 칸과 폭이 똑같아야 화살표가 정가운데로 온다(폭이 다르면 그쪽으로 쏠려 보임). */
.item-stage {
    width: 320px;
    align-items: center;
    overflow: hidden;
}

/* 바깥 네모(테두리+배경)는 고정 크기, 안쪽 아이콘은 padding만큼 더 작게. */
.item-box {
    width: 320px;
    height: 320px;
    padding: 48px;
    border-radius: 14px;
    background-color: rgb(200, 200, 200);
    border-width: 6px;
    border-color: rgb(0, 0, 0);
    transition-property: translate;
    transition-duration: 400ms;
    transition-timing-function: ease-out;
}

.item-icon {
    flex-grow: 1;
    -unity-background-scale-mode: scale-to-fit;
}

.answer-row {
    flex-direction: row;
    justify-content: center;
    width: 90%;
    max-width: 1000px;
}

.big-button {
    min-height: 190px;
    width: 45%;
    margin: 0 20px;
    font-size: 64px;
    border-radius: 14px;
    /* 흰 글자와 대비 4.5:1 이상이 되도록 진한 파랑. */
    background-color: rgb(30, 90, 180);
    border-width: 6px;
    border-color: rgb(0, 0, 0);
    color: rgb(255, 255, 255);
    white-space: normal;
}

.big-button:hover {
    background-color: rgb(25, 75, 155);
}

.big-button:active {
    background-color: rgb(20, 60, 130);
}

.big-button.danger {
    background-color: rgb(210, 55, 55);
}

.big-button.danger:hover {
    background-color: rgb(185, 45, 45);
}

/* 흰 글자와 대비 4.5:1 이상이 되도록 진한 회색. */
.big-button.secondary {
    background-color: rgb(120, 120, 120);
    color: rgb(255, 255, 255);
}

.big-button.secondary:hover,
.big-button.secondary:active {
    background-color: rgb(95, 95, 95);
}

/* 나가기 확인 다이얼로그(메인 메뉴 종료 확인창과 같은 모양). "종료" 버튼도 메인 메뉴와 같은 살구색. */
.big-button.quit-confirm {
    background-color: rgb(245, 185, 130);
    color: rgb(30, 30, 30);
}

.big-button.quit-confirm:hover,
.big-button.quit-confirm:active {
    background-color: rgb(235, 165, 105);
}

/* .big-button은 원래 answer-row(가로 두 줄)용이라 width:45%/margin:0 20px가 박혀있음.
   이 다이얼로그는 버튼이 세로로 쌓이므로 가로 꽉 채우고 위아래로 간격을 준다. */
#quit-confirm-panel .big-button {
    width: 100%;
    min-height: 160px;
    margin: 14px 0;
}

.overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.55);
    align-items: center;
    justify-content: center;
}

.overlay.hidden {
    display: none;
}

.dialog {
    width: 90%;
    max-width: 960px;
    background-color: rgb(255, 255, 255);
    border-radius: 28px;
    padding: 72px 56px;
    align-items: stretch;
}

.dialog-title {
    -unity-text-align: middle-center;
    font-size: 60px;
    color: rgb(30, 30, 30);
    margin-bottom: 32px;
    white-space: normal;
}

.result-screen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgb(245, 240, 230);
    align-items: center;
    justify-content: center;
}

.result-title {
    -unity-text-align: middle-center;
    font-size: 80px;
    color: rgb(30, 30, 30);
    margin-bottom: 110px;
    white-space: normal;
}

.result-subtitle {
    -unity-text-align: middle-center;
    font-size: 48px;
    color: rgb(70, 70, 70);
    margin-bottom: 120px;
    white-space: normal;
}

/* 결과창에 라운드별 성공/실패를 O/X로 보여주는 공용 블록. 라운드 많은 게임(물건 분류 30회 등)도
   한 줄에 안 넘치고 자연스럽게 줄바꿈되게 폭을 제한한다. */
.trial-results {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    width: 90%;
    max-width: 1040px;
    margin-bottom: 140px;
}

.trial-col {
    align-items: center;
    margin: 8px 10px;
}

.trial-round-label {
    -unity-text-align: upper-center;
    font-size: 22px;
    color: rgb(90, 90, 90);
    margin-bottom: 6px;
}

.trial-mark {
    width: 64px;
    height: 64px;
    border-radius: 12px;
    border-width: 3px;
    border-color: rgb(0, 0, 0);
    -unity-text-align: middle-center;
    font-size: 36px;
    color: rgb(0, 0, 0);
}

.trial-mark.correct {
    background-color: rgb(120, 190, 130);
}

.trial-mark.wrong {
    background-color: rgb(230, 140, 130);
}

/* 나가기로 중간에 끝나서 결과를 알 수 없는 시행. */
.trial-mark.unknown {
    background-color: rgb(210, 205, 195);
    color: rgb(90, 90, 90);
}

/* 회차가 적은 게임(2~3회)은 칸을 큼직하게, 중간(4~8회)은 그보다 조금 작게. 그보다 많으면(물건 분류 등)
   기본 크기를 그대로 써서 줄바꿈 폭에 다 들어가게 한다. */
.trial-mark.trial-size-lg {
    width: 200px;
    height: 200px;
    border-radius: 24px;
    border-width: 7px;
    font-size: 110px;
}

.trial-round-label.trial-size-lg {
    font-size: 52px;
}

.trial-mark.trial-size-md {
    width: 110px;
    height: 110px;
    border-radius: 16px;
    border-width: 5px;
    font-size: 64px;
}

.trial-round-label.trial-size-md {
    font-size: 34px;
}
