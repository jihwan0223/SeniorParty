<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <!-- 결과창/버튼/공통 배치 스타일은 게임 1(ItemSort.uss) 것을 같이 쓴다 -->
    <Style src="../ItemSort/ItemSort.uss" />
    <Style src="NumberTrail.uss" />
    <ui:VisualElement name="screen" class="screen">

        <ui:Button text="◀ 나가기" name="quit-button" class="back-button" />

        <ui:Label text="0개 / 8개" name="progress-label" class="remaining-label" />
        <ui:Label text="90" name="timer-label" class="timer-label" />
        <ui:VisualElement class="timer-bar-track">
            <ui:VisualElement name="timer-bar-fill" class="timer-bar-fill" />
        </ui:VisualElement>

        <ui:Label text="1부터 순서대로 눌러주세요" name="instruction-label" class="instruction-label" />

        <!-- 숫자 버튼은 NumberTrailGameController가 영역 크기에 맞춰 만들어 넣는다 -->
        <ui:VisualElement name="number-field" class="number-field" />

        <ui:VisualElement name="result-panel" class="result-screen hidden">
            <ui:Label text="최종 점수: 0" name="final-score-label" class="result-title" />
            <ui:Label text="총 걸린 시간: 0초" name="final-time-label" class="result-subtitle" />
            <ui:VisualElement class="answer-row">
                <ui:Button text="다시하기" name="retry-button" class="big-button" />
                <ui:Button text="나가기" name="exit-button" class="big-button danger" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="quit-confirm-panel" class="overlay hidden">
            <ui:VisualElement class="dialog">
                <ui:Label text="정말 나가시겠습니까?" class="dialog-title" />
                <ui:Button text="종료" name="quit-confirm-button" class="big-button quit-confirm" />
                <ui:Button text="취소" name="quit-cancel-button" class="big-button secondary" />
            </ui:VisualElement>
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
