/* 다른 게임의 고정 크기 상자(.stimulus-field 등)와 같은 방식. 숫자가 많을수록 같은 영역에 촘촘해진다. */
.number-field {
    width: 1100px;
    height: 820px;
    max-width: 95%;
    margin-bottom: 40px;
    border-radius: 24px;
    border-width: 6px;
    border-color: rgb(0, 0, 0);
    background-color: rgb(255, 255, 255);
}

/* 크기는 NumberTrailGameController의 ButtonSize와 같아야 한다. 태블릿 터치 영역 88dp(약 142) 이상. */
.number {
    position: absolute;
    width: 142px;
    height: 142px;
    margin: 0;
    padding: 0;
    font-size: 64px;
    border-radius: 71px;
    border-width: 6px;
    border-color: rgb(0, 0, 0);
    background-color: rgb(255, 255, 255);
    color: rgb(20, 20, 20);
}

.number:hover,
.number:active {
    background-color: rgb(255, 255, 255);
}

.number.done,
.number.done:hover,
.number.done:active {
    background-color: rgb(60, 140, 75);
    color: rgb(255, 255, 255);
}
