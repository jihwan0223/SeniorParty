<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <!-- 버튼/타이머/결과창 공통 스타일은 게임 1(ItemSort.uss) 것을 같이 쓴다 -->
    <Style src="../ItemSort/ItemSort.uss" />
    <Style src="CubeCarve.uss" />
    <ui:VisualElement name="screen" class="screen">

        <ui:Button text="◀ 나가기" name="quit-button" class="back-button" />

        <ui:Label text="1회차 / 2회" name="remaining-label" class="remaining-label" />
        <ui:Label text="7" name="timer-label" class="timer-label" />
        <ui:VisualElement name="timer-bar-track" class="timer-bar-track">
            <ui:VisualElement name="timer-bar-fill" class="timer-bar-fill" />
        </ui:VisualElement>
        <ui:Label text="이 모양대로 주사위를 깎으세요!" name="instruction-label" class="instruction-label" />
        <!-- Cube3DView(3D 렌더텍스처)를 여기에 배경으로 건다. -->
        <ui:VisualElement name="cube-view" class="cube-view" />
        <ui:VisualElement name="carve-buttons" class="answer-row">
            <ui:Button text="되돌리기" name="undo-button" class="big-button secondary" />
            <ui:Button text="완성" name="done-button" class="big-button" />
        </ui:VisualElement>

        <ui:VisualElement name="result-panel" class="result-screen hidden">
            <ui:Label text="최종 점수: 0" name="final-score-label" class="result-title" />
            <ui:VisualElement name="trial-results" class="trial-results" />
            <ui:VisualElement class="answer-row">
                <ui:Button text="다시하기" name="retry-button" class="big-button" />
                <ui:Button text="나가기" name="exit-button" class="big-button danger" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="quit-confirm-panel" class="overlay hidden">
            <ui:VisualElement class="dialog">
                <ui:Label text="정말 나가시겠습니까?" class="dialog-title" />
                <ui:Button text="종료" name="quit-confirm-button" class="big-button quit-confirm" />
                <ui:Button text="취소" name="quit-cancel-button" class="big-button secondary" />
            </ui:VisualElement>
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
