/* 위쪽 요소들은 공간이 모자라도 찌그러지지 않는다. */
.screen > * {
    flex-shrink: 0;
}

/* 타이머 라벨을 안 써서 안내 문구와 붙어 보이던 간격을 넓힘. */
#round-label {
    margin-bottom: 56px;
}

/* grid-area는 더 이상 flex-grow로 남는 공간을 전부 차지하지 않는다(그러면 .screen의 가운데 정렬이
   위쪽 텍스트엔 전혀 안 먹혀서 텍스트가 항상 맨 위에 붙어버린다 — 격자만 화면에 꽉 차게 자라는 구조였음).
   대신 격자는 MatrixGameController가 화면 크기 비율로 직접 크기를 정해서 자기 콘텐츠만큼만 차지하고,
   텍스트+격자를 합친 전체 덩어리를 .screen이 화면 중앙에 맞춘다(기종이 달라져도 자동으로 맞음). */
.grid-area {
    align-items: center;
    justify-content: center;
}

/* 크기는 MatrixGameController가 grid-area에 맞춰 정한다(최대 840). 칸은 3등분해서 채운다. */
.matrix-grid {
    width: 840px;
    height: 840px;
}

.matrix-row {
    flex-direction: row;
    flex-grow: 1;
    flex-basis: 0;
}

/* 꺼진 칸은 어둡게, 켜진 칸은 노랗게 해서 대비를 크게. */
.matrix-cell {
    flex-grow: 1;
    flex-basis: 0;
    margin: 10px;
    padding: 0;
    border-radius: 14px;
    border-width: 6px;
    border-color: rgb(0, 0, 0);
    background-color: rgb(90, 90, 90);
}

/* 기본 테마의 마우스 올림/누름 색이 켜진 것처럼 보이지 않게 막는다. */
.matrix-cell:hover,
.matrix-cell:active {
    background-color: rgb(90, 90, 90);
}

.matrix-cell.lit {
    background-color: rgb(255, 205, 50);
}

/* 맞음/틀림 색은 게임 4(표적 찾기)와 같게. 색만이 아니라 O/X 글자로도 구분(검은 글자 대비 4.5:1 이상). */
.matrix-cell.correct {
    background-color: rgb(120, 190, 130);
}

.matrix-cell.wrong {
    background-color: rgb(230, 140, 130);
}

.matrix-cell.correct,
.matrix-cell.wrong {
    font-size: 140px;
    color: rgb(0, 0, 0);
}

/* 결과창: 마지막 레벨에서 시행별로 O/X를 보여준다(걸린 시간 대신). */