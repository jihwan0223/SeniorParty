<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <!-- 버튼/결과창 공통 스타일은 게임 1(ItemSort.uss) 것을 같이 쓴다 -->
    <Style src="../ItemSort/ItemSort.uss" />
    <Style src="Matrix.uss" />
    <ui:VisualElement name="screen" class="screen">

        <!-- 게임 중간에 그만두기: 누르면 지금 레벨/라운드로 결과 화면 -->
        <ui:Button text="◀ 나가기" name="quit-button" class="back-button" />

        <!-- 게임 4(표적 찾기)처럼 위에 진행 상황만 보여준다. 틀려도 하트 같은 감점 표시는 없다. -->
        <ui:Label text="1회차 / 3회" name="round-label" class="remaining-label" />

        <ui:Label text="켜지는 순서를 잘 보세요" name="instruction-label" class="instruction-label" />

        <!-- 위 요소들을 뺀 남은 공간. 격자는 이 안에 들어가는 가장 큰 정사각형으로 맞춘다(기종마다 화면 비율이 달라도 안 넘치게).
             줄바꿈(flex-wrap)에 맡기지 않고 3줄을 직접 나눠서, 화면 배율이 달라도 칸 배치가 안 깨지게 한다 -->
        <ui:VisualElement name="grid-area" class="grid-area">
            <ui:VisualElement name="grid" class="matrix-grid">
                <ui:VisualElement class="matrix-row">
                    <ui:Button name="cell-0" class="matrix-cell" />
                    <ui:Button name="cell-1" class="matrix-cell" />
                    <ui:Button name="cell-2" class="matrix-cell" />
                </ui:VisualElement>
                <ui:VisualElement class="matrix-row">
                    <ui:Button name="cell-3" class="matrix-cell" />
                    <ui:Button name="cell-4" class="matrix-cell" />
                    <ui:Button name="cell-5" class="matrix-cell" />
                </ui:VisualElement>
                <ui:VisualElement class="matrix-row">
                    <ui:Button name="cell-6" class="matrix-cell" />
                    <ui:Button name="cell-7" class="matrix-cell" />
                    <ui:Button name="cell-8" class="matrix-cell" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="result-panel" class="result-screen hidden">
            <ui:Label text="최종 도달 레벨: 2" name="final-score-label" class="result-title" />
            <ui:VisualElement name="trial-results" class="trial-results" />
            <ui:VisualElement class="answer-row">
                <ui:Button text="다시하기" name="retry-button" class="big-button" />
                <ui:Button text="나가기" name="exit-button" class="big-button danger" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="quit-confirm-panel" class="overlay hidden">
            <ui:VisualElement class="dialog">
                <ui:Label text="정말 나가시겠습니까?" class="dialog-title" />
                <ui:Button text="종료" name="quit-confirm-button" class="big-button quit-confirm" />
                <ui:Button text="취소" name="quit-cancel-button" class="big-button secondary" />
            </ui:VisualElement>
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
