<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:sp="SeniorParty.UI" editor-extension-mode="False">
    <!-- 버튼/결과창 공통 스타일은 게임 1(ItemSort.uss) 것을 같이 쓴다 -->
    <Style src="../ItemSort/ItemSort.uss" />
    <Style src="RotateGrid.uss" />
    <ui:VisualElement name="screen" class="screen">

        <ui:Button text="◀ 나가기" name="quit-button" class="back-button" />

        <!-- 다른 게임의 "라운드" 자리에 회전 횟수를 보여준다(위치를 모든 게임과 맞춤) -->
        <ui:Label text="회전 횟수: 0번" name="move-label" class="remaining-label" />
        <ui:Label text="" name="limit-label" class="timer-label" />

        <ui:Label text="왼쪽을 돌려서 오른쪽과 같게 만드세요" name="instruction-label" class="instruction-label" />

        <ui:VisualElement class="board-row">
            <ui:VisualElement class="board-column">
                <ui:Label text="내 모양" class="board-caption" />
                <sp:ShapeGridView name="my-board" class="board" />
            </ui:VisualElement>
            <ui:VisualElement class="board-column">
                <ui:Label text="목표 모양" class="board-caption" />
                <sp:ShapeGridView name="target-board" class="board" />
            </ui:VisualElement>
        </ui:VisualElement>


        <!-- 공통 헤더 아래 화면에 다 들어가도록 조작 버튼 4개를 한 줄로 -->
        <ui:VisualElement name="op-row" class="answer-row op-row">
            <ui:Button text="좌우반전" name="flip-h-button" class="big-button op-button" />
            <ui:Button text="상하반전" name="flip-v-button" class="big-button op-button" />
            <ui:Button text="왼쪽으로&#10;90도 회전" name="rotate-left-button" class="big-button op-button" />
            <ui:Button text="오른쪽으로&#10;90도 회전" name="rotate-right-button" class="big-button op-button" />
        </ui:VisualElement>
        <ui:VisualElement name="controls-row" class="answer-row">
            <ui:Button text="초기화" name="reset-button" class="big-button secondary" />
            <ui:Button text="완료" name="done-button" class="big-button confirm" />
        </ui:VisualElement>

        <ui:VisualElement name="result-panel" class="result-screen hidden">
            <ui:Label text="최종 점수: 0점" name="final-score-label" class="result-title" />
            <ui:Label text="" name="final-detail-label" class="result-subtitle" />
            <ui:VisualElement class="board-row">
                <ui:VisualElement class="board-column">
                    <ui:Label text="내 모양" class="board-caption" />
                    <sp:ShapeGridView name="result-my-board" class="result-board" />
                </ui:VisualElement>
                <ui:VisualElement class="board-column">
                    <ui:Label text="목표 모양" class="board-caption" />
                    <sp:ShapeGridView name="result-target-board" class="result-board" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="answer-row">
                <ui:Button text="다시하기" name="retry-button" class="big-button" />
                <ui:Button text="나가기" name="exit-button" class="big-button danger" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="quit-confirm-panel" class="overlay hidden">
            <ui:VisualElement class="dialog">
                <ui:Label text="정말 나가시겠습니까?" class="dialog-title" />
                <ui:Button text="종료" name="quit-confirm-button" class="big-button quit-confirm" />
                <ui:Button text="취소" name="quit-cancel-button" class="big-button secondary" />
            </ui:VisualElement>
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
