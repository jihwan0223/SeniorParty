/* 크기는 TargetSearchingGameController의 FieldWidth/FieldHeight와 같아야 한다. */
.stimulus-field {
    width: 1000px;
    height: 640px;
    border-radius: 24px;
    border-width: 4px;
    border-color: rgb(0, 0, 0);
    background-color: rgb(255, 255, 255);
}

/* 기본 크기는 컨트롤러의 StimulusSize(142px, 태블릿 터치 영역 88dp 기준)지만, 컨트롤러가 자극마다
   크기를 무작위로 줄여서(최소 65%) 인라인 스타일로 덮어쓴다 — 작아진 자극은 터치 영역도 같이 작아진다. */
.stimulus {
    position: absolute;
    width: 142px;
    height: 142px;
    margin: 0;
    padding: 0;
    border-width: 0;
    border-radius: 50%;
    background-color: rgba(0, 0, 0, 0);
}

.stimulus:hover,
.stimulus:active {
    background-color: rgba(0, 0, 0, 0);
}

.stimulus-shape {
    width: 100%;
    height: 100%;
}

.stimulus.found {
    background-color: rgb(120, 190, 130);
}

.stimulus.wrong {
    background-color: rgb(230, 140, 130);
}
