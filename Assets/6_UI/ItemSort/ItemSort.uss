* {
    -unity-font-definition: url("../../8_Fonts/Paperlogy-7Bold.ttf");
}

.screen {
    flex-grow: 1;
    background-color: rgb(245, 240, 230);
    align-items: center;
    justify-content: center;
}

.hidden {
    display: none;
}

.remaining-label {
    -unity-text-align: middle-center;
    font-size: 36px;
    color: rgb(70, 70, 70);
    margin-bottom: 8px;
}

.timer-label {
    -unity-text-align: middle-center;
    font-size: 64px;
    color: rgb(210, 55, 55);
    margin-bottom: 20px;
}

.stage-row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-bottom: 100px;
}

.preview-box {
    width: 160px;
    height: 160px;
    margin-right: 40px;
    padding: 28px;
    border-radius: 16px;
    background-color: rgb(230, 225, 210);
    border-width: 3px;
    border-color: rgb(0, 0, 0);
}

.preview-icon {
    flex-grow: 1;
    -unity-background-scale-mode: scale-to-fit;
}

.stage-arrow {
    font-size: 70px;
    color: rgb(90, 90, 90);
    margin: 0 24px;
}

.item-stage {
    width: 90%;
    max-width: 700px;
    height: 500px;
    align-items: center;
    justify-content: center;
    overflow: hidden;
}

/* 바깥 네모(테두리+배경)는 고정 크기, 안쪽 아이콘은 padding만큼 더 작게. */
.item-box {
    width: 320px;
    height: 320px;
    padding: 50px;
    border-radius: 24px;
    background-color: rgb(200, 200, 200);
    border-width: 4px;
    border-color: rgb(0, 0, 0);
    transition-property: translate;
    transition-duration: 400ms;
    transition-timing-function: ease-out;
}

.item-icon {
    flex-grow: 1;
    -unity-background-scale-mode: scale-to-fit;
}

.answer-row {
    flex-direction: row;
    justify-content: center;
    width: 90%;
    max-width: 900px;
}

.big-button {
    min-height: 160px;
    width: 45%;
    margin: 0 20px;
    font-size: 56px;
    border-radius: 24px;
    background-color: rgb(45, 120, 220);
    border-width: 4px;
    border-color: rgb(0, 0, 0);
    color: rgb(255, 255, 255);
    white-space: normal;
}

.big-button:hover {
    background-color: rgb(35, 100, 190);
}

.big-button:active {
    background-color: rgb(25, 80, 160);
}

.big-button.danger {
    background-color: rgb(210, 55, 55);
}

.big-button.danger:hover {
    background-color: rgb(185, 45, 45);
}

.result-screen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgb(245, 240, 230);
    align-items: center;
    justify-content: center;
}

.result-title {
    -unity-text-align: middle-center;
    font-size: 80px;
    color: rgb(30, 30, 30);
    margin-bottom: 24px;
    white-space: normal;
}

.result-subtitle {
    -unity-text-align: middle-center;
    font-size: 48px;
    color: rgb(70, 70, 70);
    margin-bottom: 120px;
    white-space: normal;
}
