.instruction-label {
    -unity-text-align: middle-center;
    font-size: 56px;
    color: rgb(40, 40, 40);
    margin-bottom: 16px;
    white-space: normal;
}

/* 큐브(육각형) 가로:세로 = 0.866:1 */
.cube-view {
    width: 640px;
    height: 740px;
    margin-bottom: 40px;
}

.big-button.secondary {
    background-color: rgb(120, 120, 120);
}

.big-button.secondary:hover,
.big-button.secondary:active {
    background-color: rgb(90, 90, 90);
}
