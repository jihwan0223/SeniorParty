<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="MainMenu.uss" />
    <ui:VisualElement name="screen" class="screen">

        <!-- 메인 메뉴 -->
        <ui:VisualElement name="menu" class="menu">
            <ui:Label text="시니어 파티" name="title" class="title" />
            <ui:Button text="게임 시작" name="start-button" class="big-button" />
            <ui:Button text="설정" name="settings-button" class="big-button" />
            <ui:Button text="나가기" name="quit-button" class="big-button" />
        </ui:VisualElement>

        <!-- 게임 시작 누르면 뜸: 아래 탭바(게임/정보/임시1/임시2/임시3)로 화면 전환 -->
        <ui:VisualElement name="game-tabs-panel" class="domain-panel hidden">
            <ui:Button text="◀ 메뉴로" name="game-tabs-back-button" class="back-button" />

            <!-- 게임 탭: 게임 박스 9개 -->
            <ui:VisualElement name="tab-content-game" class="game-menu-top">
                <ui:VisualElement class="game-box-container">
                    <ui:Button text="게임 1" name="game-box-1" class="game-box" />
                    <ui:Button text="게임 2" name="game-box-2" class="game-box" />
                    <ui:Button text="게임 3" name="game-box-3" class="game-box" />
                    <ui:Button text="게임 4" name="game-box-4" class="game-box" />
                    <ui:Button text="게임 5" name="game-box-5" class="game-box" />
                    <ui:Button text="게임 6" name="game-box-6" class="game-box" />
                    <ui:Button text="게임 7" name="game-box-7" class="game-box" />
                    <ui:Button text="게임 8" name="game-box-8" class="game-box" />
                    <ui:Button text="게임 9" name="game-box-9" class="game-box" />
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- 정보/임시 탭: 아직 내용 없음 -->
            <ui:VisualElement name="tab-content-info" class="game-menu-top hidden">
                <ui:Label text="정보 (준비 중)" class="select-title" />
            </ui:VisualElement>
            <ui:VisualElement name="tab-content-temp1" class="game-menu-top hidden">
                <ui:Label text="임시1 (준비 중)" class="select-title" />
            </ui:VisualElement>
            <ui:VisualElement name="tab-content-temp2" class="game-menu-top hidden">
                <ui:Label text="임시2 (준비 중)" class="select-title" />
            </ui:VisualElement>
            <ui:VisualElement name="tab-content-temp3" class="game-menu-top hidden">
                <ui:Label text="임시3 (준비 중)" class="select-title" />
            </ui:VisualElement>

            <ui:VisualElement name="game-tabs-bar" class="game-nav-grid">
                <ui:Button text="게임" name="bottom-tab-game" class="game-nav-item" />
                <ui:VisualElement class="game-nav-divider" />
                <ui:Button text="정보" name="bottom-tab-info" class="game-nav-item" />
                <ui:VisualElement class="game-nav-divider" />
                <ui:Button text="임시1" name="bottom-tab-temp1" class="game-nav-item" />
                <ui:VisualElement class="game-nav-divider" />
                <ui:Button text="임시2" name="bottom-tab-temp2" class="game-nav-item" />
                <ui:VisualElement class="game-nav-divider" />
                <ui:Button text="임시3" name="bottom-tab-temp3" class="game-nav-item" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- 난이도 선택 (게임 박스 누르면 뜸) -->
        <ui:VisualElement name="difficulty-panel" class="domain-panel hidden">
            <ui:Button text="◀ 메뉴로" name="difficulty-back-button" class="back-button" />
            <ui:Label text="난이도를 선택하세요" class="select-title" />
            <ui:VisualElement class="difficulty-tabs">
                <ui:Button text="하" name="difficulty-easy-button" class="difficulty-button" />
                <ui:Button text="중" name="difficulty-normal-button" class="difficulty-button" />
                <ui:Button text="상" name="difficulty-hard-button" class="difficulty-button" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- 아이콘 선택 -->
        <ui:VisualElement name="select-panel" class="select-panel hidden">
            <ui:Button text="⚙" name="select-settings-button" class="gear-button" />
            <ui:Label text="아이콘을 골라주세요" class="select-title" />
            <ui:VisualElement class="select-row">
                <ui:Button text="◀" name="prev-button" class="arrow-button" />
                <ui:Button name="icon-button" class="icon" />
                <ui:Button text="▶" name="next-button" class="arrow-button" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- 설정 (볼륨 3종 + 초기화/나가기/종료) -->
        <ui:VisualElement name="settings-panel" class="overlay hidden">
            <ui:VisualElement name="settings-dialog" class="dialog dialog-large">
                <ui:Button text="✕" name="settings-close-button" class="x-button" />
                <ui:Label text="설정" class="dialog-title" />
                <ui:VisualElement class="setting-row">
                    <ui:Label text="전체 볼륨" class="setting-label" />
                    <ui:Slider name="master-volume-slider" low-value="0" high-value="100" value="80" class="setting-slider" />
                    <ui:Label text="80" name="master-volume-value" class="setting-value" />
                </ui:VisualElement>

                <ui:VisualElement class="setting-row">
                    <ui:Label text="배경음악" class="setting-label" />
                    <ui:Slider name="bgm-volume-slider" low-value="0" high-value="100" value="80" class="setting-slider" />
                    <ui:Label text="80" name="bgm-volume-value" class="setting-value" />
                </ui:VisualElement>

                <ui:VisualElement class="setting-row">
                    <ui:Label text="효과음" class="setting-label" />
                    <ui:Slider name="sfx-volume-slider" low-value="0" high-value="100" value="80" class="setting-slider" />
                    <ui:Label text="80" name="sfx-volume-value" class="setting-value" />
                </ui:VisualElement>
                <ui:VisualElement class="spacer" />
                <ui:Button text="설정 초기화" name="settings-reset-button" class="big-button secondary" />
                <ui:Button text="메뉴로 나가기" name="menu-exit-button" class="big-button" />
                <ui:Button text="게임 종료" name="settings-quit-button" class="big-button danger" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- 종료 확인 -->
        <ui:VisualElement name="quit-panel" class="overlay hidden">
            <ui:VisualElement class="dialog">
                <ui:Label text="게임을 종료할까요?" class="dialog-title" />
                <ui:Button text="종료" name="quit-confirm-button" class="big-button" />
                <ui:Button text="취소" name="quit-cancel-button" class="big-button secondary" />
            </ui:VisualElement>
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
